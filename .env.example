# -----------------------------------------------------------------------------
# KONFIGURASI LINGKUNGAN (ENVIRONMENT TEMPLATE) — SELOKO WEB
# -----------------------------------------------------------------------------

# Port Development Server Vite
VITE_PORT=3001

# Endpoint Backend SELOKO API
# Dev: pakai path relatif "/api" agar diteruskan proxy Vite (vite.config.ts).
# Memakai URL absolut (http://localhost:3000/api) membuat request lintas origin
# dan cookie refresh HttpOnly (SameSite=Strict) tidak ikut terkirim → /auth/refresh
# membalas 401 "No refresh token provided", terutama saat dev server dibuka lewat
# 127.0.0.1 / IP LAN. Produksi: isi URL absolut API yang sebenarnya.
VITE_API_BASE_URL=/api

# Target asli backend untuk proxy Vite (hanya dibaca sisi server, tanpa VITE_)
API_PROXY_TARGET=http://localhost:3000

# Konteks Aplikasi Default untuk App Switcher (seloko | bapenda-profile)
VITE_DEFAULT_APP_CODE=seloko

# Identitas & Branding Aplikasi
VITE_APP_NAME="SELOKO WEB"
VITE_APP_INSTITUTION="BPKPD Provinsi Jambi"

# ImageKit CDN Endpoint
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/o7kpef481o
