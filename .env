# -----------------------------------------------------------------------------
# KONFIGURASI LINGKUNGAN (ENVIRONMENT) — SELOKO WEB
# -----------------------------------------------------------------------------

# Port Development Server Vite (Memastikan tidak bentrok dengan backend :3000 / portal :3002)
VITE_PORT=3001

# Endpoint Backend SELOKO API
# RELATIF, bukan absolut: dev server mem-proxy /api → API_PROXY_TARGET.
# Wajib relatif agar cookie refresh (SameSite=Strict) tetap same-origin.
VITE_API_BASE_URL=/api

# Target asli backend untuk proxy Vite (dibaca server, tidak masuk bundle)
API_PROXY_TARGET=http://localhost:3000

# Konteks Aplikasi Default untuk App Switcher (seloko | bapenda-profile)
VITE_DEFAULT_APP_CODE=seloko

# Identitas & Branding Aplikasi
VITE_APP_NAME="SELOKO WEB"
VITE_APP_INSTITUTION="BPKPD Provinsi Jambi"

# ImageKit CDN Endpoint (Untuk optimasi dan transformasi gambar langsung dari CDN)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/o7kpef481o
